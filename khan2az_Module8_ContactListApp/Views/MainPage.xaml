<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             x:Class="khan2az_Module8_ContactListApp.Views.MainPage"
             x:DataType="viewmodels:AddContactViewModel"
             Title="Add Contact">

    <VerticalStackLayout Padding="20" Spacing="10">
        <Entry Placeholder="Name" Text="{Binding Name}" />
        <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" />
        <Entry Placeholder="Phone Number" Text="{Binding PhoneNumber}" Keyboard="Telephone" />
        <Editor Placeholder="Description" Text="{Binding Description}" HeightRequest="100"/>
        <Button Text="Save Contact" Command="{Binding SaveCommand}" />
    </VerticalStackLayout>
</ContentPage>

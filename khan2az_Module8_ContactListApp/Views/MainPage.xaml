<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             xmlns:models="clr-namespace:khan2az_Module8_ContactListApp.Models"
             x:Class="khan2az_Module8_ContactListApp.Views.MainPage"
             x:DataType="vm:ContactViewModel">
    <VerticalStackLayout Padding="20">
        <Label Text="Add New Contact" FontSize="24" FontAttributes="Bold" />
        <Entry Placeholder="Name" Text="{Binding SelectedContact.Name}" />
        <Entry Placeholder="Email" Text="{Binding SelectedContact.Email}" />
        <Entry Placeholder="Phone" Text="{Binding SelectedContact.PhoneNumber}" />
        <Editor Placeholder="Description" Text="{Binding SelectedContact.Description}" />
        <Button Text="Save" Command="{Binding SaveContactAsyncCommand}" />
    </VerticalStackLayout>
</ContentPage>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             xmlns:models="clr-namespace:khan2az_Module8_ContactListApp.Models"
             x:Class="khan2az_Module8_ContactListApp.Views.ContactsPage"
             x:DataType="viewmodels:ContactsViewModel"
             Title="Contacts List">

    <VerticalStackLayout Padding="10">
        <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="Single"
                        SelectionChangedCommand="{Binding ViewDetailsCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ContactPerson">
                    <Border Stroke="Gray" StrokeThickness="1" Margin="5" Padding="10" Background="White" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold"/>
                            <Label Text="{Binding Email}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Add New Contact" Command="{Binding AddNewContactCommand}" />
    </VerticalStackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             x:Class="khan2az_Module8_ContactListApp.Views.ContactsPage"
             x:DataType="vm:ContactViewModel">
    <VerticalStackLayout Padding="20">
        <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Email}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Add New Contact" Command="{Binding GoToAddContactPageCommand}" />
    </VerticalStackLayout>
</ContentPage>

<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             xmlns:models="clr-namespace:khan2az_Module8_ContactListApp.Models"
             x:Class="khan2az_Module8_ContactListApp.Views.ContactsPage"
             x:DataType="vm:ContactViewModel">
    <VerticalStackLayout>
        <CollectionView ItemsSource="{Binding Contacts}" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ContactPerson">
                    <Border Stroke="LightGray" StrokeThickness="1" Padding="10" Margin="5">
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                            <Label Text="{Binding Email}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Add Contact" Command="{Binding GoToAddContactPageCommand}" />
    </VerticalStackLayout>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:khan2az_Module8_ContactListApp.ViewModels"
             x:Class="khan2az_Module8_ContactListApp.Views.ContactDetailsPage"
             x:DataType="vm:ContactViewModel">
    <VerticalStackLayout Padding="20">
        <Entry Text="{Binding SelectedContact.Name}" />
        <Entry Text="{Binding SelectedContact.Email}" />
        <Entry Text="{Binding SelectedContact.PhoneNumber}" />
        <Editor Text="{Binding SelectedContact.Description}" />
        <Button Text="Back" Clicked="OnBackClicked" />
        <Button Text="Save" Command="{Binding UpdateContactCommand}" />
    </VerticalStackLayout>
</ContentPage>